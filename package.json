{
  "name": "ww3-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live dashboard of conflict escalation and de-escalation signals",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json --noEmit",
    "start": "npm run build && node src/server/server.ts",
    "dev": "tsc -p tsconfig.client.json --watch --preserveWatchOutput & node --watch src/server/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2"
  }
}
